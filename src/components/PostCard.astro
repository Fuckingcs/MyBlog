---
import type { CollectionEntry } from 'astro:content';
import { previewFromMarkdown } from '../lib/post-preview.mjs';

interface Props { post: CollectionEntry<'posts'> }
const { post } = Astro.props;
const { image, excerpt } = previewFromMarkdown(post.body ?? '');
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const imageUrl = image as string | null;
const cover = imageUrl && imageUrl.startsWith('/') && !imageUrl.startsWith('//') ? `${base}${imageUrl}` : imageUrl;
const date = new Intl.DateTimeFormat('zh-CN', { year: 'numeric', month: 'long', day: 'numeric' }).format(post.data.date);
---
<a class="post-card" href={`${base}/posts/${post.id}/`} aria-label={`阅读 ${post.data.title}`}>
  <div class="post-cover">{cover && <img src={cover} alt="" loading="lazy" />}</div>
  <div class="post-copy">
    <p class="post-date">{date}</p>
    <h2 class="post-title">{post.data.title}</h2>
    <p class="post-excerpt">{excerpt || '点击阅读这篇文章。'}</p>
  </div>
</a>
