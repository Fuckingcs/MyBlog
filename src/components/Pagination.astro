---
interface Props {
  section: 'essays' | 'notes';
  page: number;
  pageCount: number;
}
const { section, page, pageCount } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const pageUrl = (number: number) => `${base}/${section}/${number === 1 ? '' : `${number}/`}`;
---
{pageCount > 1 && <nav class="pagination" aria-label="文章分页">
  {page > 1 && <a class="direction" href={pageUrl(page - 1)} rel="prev">← 上一页</a>}
  {Array.from({ length: pageCount }, (_, index) => index + 1).map((number) => number === page
    ? <span class="current" aria-current="page">{number}</span>
    : <a href={pageUrl(number)} aria-label={`第 ${number} 页`}>{number}</a>)}
  {page < pageCount && <a class="direction" href={pageUrl(page + 1)} rel="next">下一页 →</a>}
</nav>}
