---
import BaseLayout from '../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<BaseLayout title="首页" active="home">
  <div class="home-shell">
    <section class="home-intro" aria-labelledby="intro-title">
      <div class="home-intro-main">
        <div class="eyebrow">PERSONAL BLOG / 关于我</div>
        <h1 id="intro-title">你好，我是<span>胡某人。</span></h1>
        <p class="home-lead">北京科技大学 · 计算机科学与技术<br />关注强化学习（RL），也喜欢把零散的思考写下来。</p>
        <p class="home-note">这里收录生活里的随感，以及学习路上的笔记。欢迎随意翻阅。</p>
      </div>
      <div class="profile-panel" aria-label="个人信息">
        <div class="profile-heading">一些关于我的关键词</div>
        <dl class="profile-grid">
          <div><dt>学校</dt><dd>北京科技大学</dd></div>
          <div><dt>专业</dt><dd>计算机科学与技术</dd></div>
          <div><dt>研究兴趣</dt><dd>强化学习 RL</dd></div>
          <div><dt>人格类型</dt><dd>ENTP</dd></div>
        </dl>
      </div>
    </section>

    <section class="home-sections" aria-label="文章栏目">
      <a class="section-link" href={`${base}/essays/`}>
        <div><span class="section-kicker">01 / ESSAYS</span><h2>随感</h2><p>生活片段，偶尔的想法。</p></div>
        <span class="section-arrow" aria-hidden="true">↗</span>
      </a>
      <a class="section-link" href={`${base}/notes/`}>
        <div><span class="section-kicker">02 / NOTES</span><h2>笔记</h2><p>读书、学习与技术记录。</p></div>
        <span class="section-arrow" aria-hidden="true">↗</span>
      </a>
    </section>
  </div>
</BaseLayout>
